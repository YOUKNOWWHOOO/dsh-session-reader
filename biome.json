{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "root": false,
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "includes": ["**", "!tests/.tmp", "!tmp"]
  },
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  }
}
