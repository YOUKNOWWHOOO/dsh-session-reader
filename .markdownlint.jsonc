{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint/main/schema/markdownlint-config-schema.json",
  "comment": "session-reader 技能基线——与 dsh 全局基线（~/.dsh/全局规范/配置文件模板/.markdownlint.jsonc）逐条一致，只允许在此基础上更严格；本技能全部 md 产物必须真实通过本配置（无文件内豁免、无配置放宽）。",
  "default": true,
  "MD001": true,
  "MD003": { "style": "atx" },
  "MD004": { "style": "dash" },
  "MD005": true,
  "MD007": { "indent": 2 },
  "MD009": { "br_spaces": 2 },
  "MD010": true,
  "MD011": true,
  "MD012": { "maximum": 1 },
  "MD013": false,
  "MD014": true,
  "MD018": true,
  "MD019": true,
  "MD022": true,
  "MD023": true,
  "MD024": { "siblings_only": true },
  "MD025": false,
  "MD026": { "punctuation": ".,;:!。，；：！" },
  "MD027": true,
  "MD028": true,
  "MD029": { "style": "one" },
  "MD030": { "ul_single": 1, "ol_single": 1, "ul_multi": 1, "ol_multi": 1 },
  "MD031": true,
  "MD032": true,
  "MD033": false,
  "MD034": true,
  "MD035": { "style": "---" },
  "MD036": true,
  "MD037": true,
  "MD038": true,
  "MD039": true,
  "MD040": true,
  "MD041": false,
  "MD042": true,
  "MD043": false,
  "MD044": false,
  "MD045": true,
  "MD046": { "style": "fenced" },
  "MD047": true,
  "MD048": { "style": "backtick" },
  "MD049": { "style": "asterisk" },
  "MD050": { "style": "asterisk" },
  "MD051": true,
  "MD052": true,
  "MD053": true,
  "MD054": { "autolink": true, "collapsed": true, "full": true, "inline": true, "shortcut": true },
  "MD055": { "style": "leading_and_trailing" },
  "MD056": true,
  "MD058": true,
  "MD060": { "style": "any" }
}
